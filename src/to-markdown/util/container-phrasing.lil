import { apply, arrLen, arrSet, jsString, objectAssign, pop, push, replaceStr, undef } from "../../parse/micromark/host.lil";
import { encodeCharacterReference } from "./encode-character-reference.lil";

Regex trailingEol = new Regex("(\\r?\\n|\\r)$", "");

export string containerPhrasing(JsValue parent, JsValue state, JsValue info) {
  JsValue indexStack = state["indexStack"];
  JsValue children = parent["children"];
  if (!children.truthy()) {
    children = JS.array();
  }
  JsValue results = JS.array();
  int index = -1;
  string before = jsString(info["before"]);
  JsValue encodeAfter = undef();
  JS.invoke(indexStack, "push", -1);
  JsValue tracker = JS.invoke(state, "createTracker", info);
  int n = arrLen(children);
  while (true) {
    index = index + 1;
    if (index >= n) {
      break;
    }
    JsValue child = children[index];
    string after = "";
    arrSet(indexStack, arrLen(indexStack) - 1, index);
    if (index + 1 < n) {
      JsValue handle = JS.get((state["handle"])["handlers"], jsString(children[index + 1]["type"]));
      if (handle.truthy() && handle["peek"].truthy()) {
        handle = handle["peek"];
      }
      if (handle.truthy()) {
        JsValue peekInfo = objectAssign(JS.object(), JS.invoke(tracker, "current"));
        peekInfo["before"] = "";
        peekInfo["after"] = "";
        string peeked = jsString(JS.call(handle, JS.undefined(), children[index + 1], parent, state, peekInfo));
        if (peeked.length > 0) {
          after = peeked.charAt(0);
        }
      }
    } else {
      after = jsString(info["after"]);
    }
    if (arrLen(results) > 0 && (before == "\r" || before == "\n") && jsString(child["type"]) == "html") {
      string last = jsString(results[arrLen(results) - 1]);
      arrSet(results, arrLen(results) - 1, replaceStr(last, trailingEol, " "));
      before = " ";
      tracker = JS.invoke(state, "createTracker", info);
      JS.invoke(tracker, "move", JS.invoke(results, "join", ""));
    }
    JsValue childInfo = objectAssign(JS.object(), JS.invoke(tracker, "current"));
    childInfo["after"] = after;
    childInfo["before"] = before;
    string value = jsString(JS.invoke(state, "handle", child, parent, state, childInfo));
    if (encodeAfter.truthy() && jsString(encodeAfter) == value.slice(0, 1)) {
      value = encodeCharacterReference(jsString(encodeAfter).charCodeAt(0)) + value.slice(1);
    }
    JsValue encodingInfo = state["attentionEncodeSurroundingInfo"];
    state["attentionEncodeSurroundingInfo"] = undef();
    encodeAfter = undef();
    if (encodingInfo.truthy()) {
      if (arrLen(results) > 0 && encodingInfo["before"].truthy()) {
        string last = jsString(results[arrLen(results) - 1]);
        string lastChar = "";
        if (last.length > 0) {
          lastChar = last.slice(last.length - 1);
        }
        if (before == lastChar) {
          arrSet(results, arrLen(results) - 1, last.slice(0, last.length - 1) + encodeCharacterReference(before.charCodeAt(0)));
        }
      }
      if (encodingInfo["after"].truthy()) {
        encodeAfter = after;
      }
    }
    JS.invoke(tracker, "move", value);
    JS.invoke(results, "push", value);
    if (value.length > 0) {
      before = value.slice(value.length - 1);
    } else {
      before = "";
    }
  }
  pop(indexStack);
  return jsString(JS.invoke(results, "join", ""));
}
