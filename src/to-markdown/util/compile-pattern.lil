import { jsString } from "../../parse/micromark/host.lil";
import { makeRegex } from "../js.lil";

Regex specialChar = new Regex("[|\\\\{}()[\\]^$+*?.-]", "");

export JsValue compilePattern(JsValue pattern) {
  if (!pattern["_compiled"].truthy()) {
    string before = "";
    if (pattern["atBreak"].truthy()) {
      before = "[\\r\\n][\\t ]*";
    }
    JsValue beforePat = pattern["before"];
    if (beforePat.truthy()) {
      before = before + "(?:" + jsString(beforePat) + ")";
    }
    string source = "";
    if (before.length > 0) {
      source = "(" + before + ")";
    }
    string character = jsString(pattern["character"]);
    if (specialChar.test(character)) {
      source = source + "\\";
    }
    source = source + character;
    JsValue afterPat = pattern["after"];
    if (afterPat.truthy()) {
      source = source + "(?:" + jsString(afterPat) + ")";
    }
    pattern["_compiled"] = makeRegex(source, "g");
  }
  return pattern["_compiled"];
}
