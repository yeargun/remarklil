import { arrLen, hasOwn, includesVal, jsString, push, regexExec, replaceFn } from "../../parse/micromark/host.lil";
import { encodeCharacterReference } from "./encode-character-reference.lil";
import { patternInScope } from "./pattern-in-scope.lil";

Regex punct = new Regex("[!-/:-@[-`{-~]", "");


string escapeBackslashes(string value, string after) {
  Regex expression = new Regex("\\\\(?=[!-/:-@[-`{-~])", "g");
  int[] positions = [];
  string[] results = [];
  string whole = value + after;
  int start = 0;
  while (true) {
    JsValue found = regexExec(expression, whole);
    if (JS.isNullish(found)) {
      break;
    }
    positions.push(JS.number(found["index"]).toInt());
  }
  for (int index = 0; index < positions.length; index++) {
    if (start != positions[index]) {
      results.push(value.slice(start, positions[index]));
    }
    results.push("\\");
    start = positions[index];
  }
  results.push(value.slice(start));
  return results.join("");
}

export string safe(JsValue state, JsValue input, JsValue config) {
  string before = "";
  string after = "";
  if (config["before"].truthy()) {
    before = jsString(config["before"]);
  }
  string mid = "";
  if (input.truthy()) {
    mid = jsString(input);
  }
  if (config["after"].truthy()) {
    after = jsString(config["after"]);
  }
  string value = before + mid + after;
  // One entry per unsafe position: where an escape may go, and whether only a `before`/`after` context made it unsafe.
  int[] positions = [];
  bool[] befores = [];
  bool[] afters = [];
  string[] result = [];
  JsValue unsafe = state["unsafe"];
  int un = arrLen(unsafe);
  for (int index = 0; index < un; index++) {
    JsValue pattern = unsafe[index];
    if (!patternInScope(state["stack"], pattern)) {
      continue;
    }
    JsValue expression = JS.invoke(state, "compilePattern", pattern);
    while (true) {
      JsValue found = JS.invoke(expression, "exec", value);
      if (JS.isNullish(found)) {
        break;
      }
      bool beforeCond = JS.in("before", pattern) || pattern["atBreak"].truthy();
      bool afterCond = JS.in("after", pattern);
      int position = JS.number(found["index"]).toInt();
      if (beforeCond) {
        position = position + jsString(found[1]).length;
      }
      int slot = -1;
      for (int m = 0; m < positions.length; m++) {
        if (positions[m] == position) {
          slot = m;
          break;
        }
      }
      if (slot < 0) {
        positions.push(position);
        befores.push(beforeCond);
        afters.push(afterCond);
      } else {
        if (!beforeCond) {
          befores[slot] = false;
        }
        if (!afterCond) {
          afters[slot] = false;
        }
      }
    }
  }
  // Positions are distinct, so an insertion sort gives upstream's numeric sort.
  for (int i = 1; i < positions.length; i++) {
    int position = positions[i];
    bool b = befores[i];
    bool a = afters[i];
    int j = i - 1;
    while (j >= 0 && positions[j] > position) {
      positions[j + 1] = positions[j];
      befores[j + 1] = befores[j];
      afters[j + 1] = afters[j];
      j--;
    }
    positions[j + 1] = position;
    befores[j + 1] = b;
    afters[j + 1] = a;
  }
  int start = before.length;
  int end = value.length - after.length;
  int count = positions.length;
  for (int index = 0; index < count; index++) {
    int position = positions[index];
    if (position < start || position >= end) {
      continue;
    }
    // Sorted and distinct: the info for `position ± 1`, when present, is the neighbouring mark.
    if (position + 1 < end && index + 1 < count && positions[index + 1] == position + 1 && afters[index] && !befores[index + 1] && !afters[index + 1]) {
      continue;
    }
    if (index > 0 && positions[index - 1] == position - 1 && befores[index] && !befores[index - 1] && !afters[index - 1]) {
      continue;
    }
    if (start != position) {
      result.push(escapeBackslashes(value.slice(start, position), "\\"));
    }
    start = position;
    string ch = value.charAt(position);
    JsValue encode = config["encode"];
    if (punct.test(ch) && !(encode.truthy() && includesVal(encode, ch))) {
      result.push("\\");
    } else {
      result.push(encodeCharacterReference(value.charCodeAt(position)));
      start = start + 1;
    }
  }
  result.push(escapeBackslashes(value.slice(start, end), after));
  return result.join("");
}

export JsValue unusedReplace(JsValue value) {
  return replaceFn(value, punct, JS.undefined());
}
