import { apply, arrLen, arrSet, jsString, objectAssign, pop, push, undef } from "../../parse/micromark/host.lil";

string between(JsValue left, JsValue right, JsValue parent, JsValue state) {
  int index = arrLen(state["join"]);
  while (true) {
    index = index - 1;
    if (index < 0) {
      break;
    }
    JsValue result = JS.call(state["join"][index], state["join"], left, right, parent, state);
    if (JS.strictEqual(result, true) || JS.strictEqual(result, 1)) {
      break;
    }
    if (JS.typeOf(result) == "number") {
      int extra = JS.number(result).toInt();
      return "\n".repeat(1 + extra);
    }
    if (JS.strictEqual(result, false)) {
      return "\n\n<!---->\n\n";
    }
  }
  return "\n\n";
}

export string containerFlow(JsValue parent, JsValue state, JsValue info) {
  JsValue indexStack = state["indexStack"];
  JsValue children = parent["children"];
  if (!children.truthy()) {
    children = JS.array();
  }
  JsValue tracker = JS.invoke(state, "createTracker", info);
  JsValue results = JS.array();
  int index = -1;
  int n = arrLen(children);
  JS.invoke(indexStack, "push", -1);
  while (true) {
    index = index + 1;
    if (index >= n) {
      break;
    }
    JsValue child = children[index];
    arrSet(indexStack, arrLen(indexStack) - 1, index);
    JsValue childInfo = objectAssign(JS.object(), JS.invoke(tracker, "current"));
    childInfo["before"] = "\n";
    childInfo["after"] = "\n";
    JS.invoke(results, "push", JS.invoke(tracker, "move", JS.invoke(state, "handle", child, parent, state, childInfo)));
    if (jsString(child["type"]) != "list") {
      state["bulletLastUsed"] = undef();
    }
    if (index < n - 1) {
      JS.invoke(results, "push", JS.invoke(tracker, "move", between(child, children[index + 1], parent, state)));
    }
  }
  pop(indexStack);
  return jsString(JS.invoke(results, "join", ""));
}
