import { jsString, objectAssign } from "../../parse/micromark/host.lil";

Regex splitEol = new Regex("\\r?\\n|\\r", "g");

export JsValue track(JsValue config) {
  JsValue options = config;
  if (!options.truthy()) {
    options = JS.object();
  }
  JsValue now = JS.get(options, "now");
  if (!now.truthy()) {
    now = JS.object();
  }
  float lineShift = 0.0;
  if (JS.get(options, "lineShift").truthy()) {
    lineShift = JS.number(JS.get(options, "lineShift"));
  }
  JsValue lineV = JS.get(now, "line");
  if (!lineV.truthy()) {
    lineV = 1;
  }
  JsValue columnV = JS.get(now, "column");
  if (!columnV.truthy()) {
    columnV = 1;
  }
  float line = JS.number(lineV);
  float column = JS.number(columnV);

  JsValue current = JS.method0((JsValue _s) => {
    return JS.object(
      "now",
      JS.object("line", line, "column", column),
      "lineShift",
      lineShift
    );
  });

  JsValue shift = JS.method1((JsValue _s, JsValue value) => {
    lineShift = lineShift + JS.number(value);
    return JS.undefined();
  });

  JsValue move = JS.method1((JsValue _s, JsValue input) => {
    string value = "";
    if (input.truthy()) {
      value = jsString(input);
    }
    string[] chunks = JS.assume(JS.call(JS.get(value, "split"), value, splitEol));
    int n = chunks.length;
    string tail = chunks[n - 1];
    line = line + (n - 1) * 1.0;
    if (n == 1) {
      column = column + tail.length * 1.0;
    } else {
      column = 1.0 + tail.length * 1.0 + lineShift;
    }
    return value;
  });

  return JS.object("move", move, "current", current, "shift", shift);
}

export JsValue unusedTrackAssign(JsValue value) {
  return objectAssign(JS.object(), value);
}
