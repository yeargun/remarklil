import { arrLen, jsString } from "../../parse/micromark/host.lil";
import { mdastToString } from "./mdast-to-string.lil";
import { opt } from "../js.lil";

Regex hasProtocol = new Regex("^[a-z][a-z+.-]+:", "i");
Regex badUrl = new Regex("[\\x00- <>\\x7F]", "");

export bool formatLinkAsAutolink(JsValue node, JsValue state) {
  if (opt(state)["resourceLink"].truthy()) {
    return false;
  }
  JsValue url = node["url"];
  if (!url.truthy()) {
    return false;
  }
  if (node["title"].truthy()) {
    return false;
  }
  JsValue children = node["children"];
  if (!children.truthy() || arrLen(children) != 1) {
    return false;
  }
  if (jsString(children[0]["type"]) != "text") {
    return false;
  }
  string raw = mdastToString(node, JS.undefined());
  string urlStr = jsString(url);
  if (raw != urlStr && "mailto:" + raw != urlStr) {
    return false;
  }
  if (!hasProtocol.test(urlStr)) {
    return false;
  }
  if (badUrl.test(urlStr)) {
    return false;
  }
  return true;
}
