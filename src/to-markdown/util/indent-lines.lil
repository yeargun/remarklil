import { jsString, push, undef } from "../../parse/micromark/host.lil";

Regex eol = new Regex("\\r?\\n|\\r", "g");

export string indentLines(JsValue value, JsValue mapper) {
  string text = jsString(value);
  JsValue result = JS.array();
  int start = 0;
  int line = 0;
  JsValue found = JS.undefined();
  while (true) {
    found = eol.exec(text);
    if (JS.isNullish(found)) {
      break;
    }
    string piece = text.slice(start, jsIntIndex(found));
    JS.invoke(result, "push", JS.call(mapper, undef(), piece, line, piece.length == 0));
    JS.invoke(result, "push", found[0]);
    start = jsIntIndex(found) + jsString(found[0]).length;
    line = line + 1;
  }
  string tail = text.slice(start);
  JS.invoke(result, "push", JS.call(mapper, undef(), tail, line, tail.length == 0));
  return jsString(JS.invoke(result, "join", ""));
}

int jsIntIndex(JsValue found) {
  return JS.number(found["index"]).toInt();
}
