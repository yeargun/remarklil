// mdast-util-to-markdown lib/unsafe.js: the default patterns, in upstream order and key order.
JsValue fullPhrasingSpans = JS.array("autolink", "destinationLiteral", "destinationRaw", "reference", "titleQuote", "titleApostrophe");

export JsValue defaultUnsafe = JS.array(
  JS.object("character", "\t", "after", "[\\r\\n]", "inConstruct", "phrasing"),
  JS.object("character", "\t", "before", "[\\r\\n]", "inConstruct", "phrasing"),
  JS.object("character", "\t", "inConstruct", JS.array("codeFencedLangGraveAccent", "codeFencedLangTilde")),
  JS.object("character", "\r", "inConstruct", JS.array("codeFencedLangGraveAccent", "codeFencedLangTilde", "codeFencedMetaGraveAccent", "codeFencedMetaTilde", "destinationLiteral", "headingAtx")),
  JS.object("character", "\n", "inConstruct", JS.array("codeFencedLangGraveAccent", "codeFencedLangTilde", "codeFencedMetaGraveAccent", "codeFencedMetaTilde", "destinationLiteral", "headingAtx")),
  JS.object("character", " ", "after", "[\\r\\n]", "inConstruct", "phrasing"),
  JS.object("character", " ", "before", "[\\r\\n]", "inConstruct", "phrasing"),
  JS.object("character", " ", "inConstruct", JS.array("codeFencedLangGraveAccent", "codeFencedLangTilde")),
  JS.object("character", "!", "after", "\\[", "inConstruct", "phrasing", "notInConstruct", fullPhrasingSpans),
  JS.object("character", "\"", "inConstruct", "titleQuote"),
  JS.object("atBreak", true, "character", "#"),
  JS.object("character", "#", "inConstruct", "headingAtx", "after", "(?:[\r\n]|$)"),
  JS.object("character", "&", "after", "[#A-Za-z]", "inConstruct", "phrasing"),
  JS.object("character", "'", "inConstruct", "titleApostrophe"),
  JS.object("character", "(", "inConstruct", "destinationRaw"),
  JS.object("before", "\\]", "character", "(", "inConstruct", "phrasing", "notInConstruct", fullPhrasingSpans),
  JS.object("atBreak", true, "before", "\\d+", "character", ")"),
  JS.object("character", ")", "inConstruct", "destinationRaw"),
  JS.object("atBreak", true, "character", "*", "after", "(?:[ \t\r\n*])"),
  JS.object("character", "*", "inConstruct", "phrasing", "notInConstruct", fullPhrasingSpans),
  JS.object("atBreak", true, "character", "+", "after", "(?:[ \t\r\n])"),
  JS.object("atBreak", true, "character", "-", "after", "(?:[ \t\r\n-])"),
  JS.object("atBreak", true, "before", "\\d+", "character", ".", "after", "(?:[ \t\r\n]|$)"),
  JS.object("atBreak", true, "character", "<", "after", "[!/?A-Za-z]"),
  JS.object("character", "<", "after", "[!/?A-Za-z]", "inConstruct", "phrasing", "notInConstruct", fullPhrasingSpans),
  JS.object("character", "<", "inConstruct", "destinationLiteral"),
  JS.object("atBreak", true, "character", "="),
  JS.object("atBreak", true, "character", ">"),
  JS.object("character", ">", "inConstruct", "destinationLiteral"),
  JS.object("atBreak", true, "character", "["),
  JS.object("character", "[", "inConstruct", "phrasing", "notInConstruct", fullPhrasingSpans),
  JS.object("character", "[", "inConstruct", JS.array("label", "reference")),
  JS.object("character", "\\", "after", "[\\r\\n]", "inConstruct", "phrasing"),
  JS.object("character", "]", "inConstruct", JS.array("label", "reference")),
  JS.object("atBreak", true, "character", "_"),
  JS.object("character", "_", "inConstruct", "phrasing", "notInConstruct", fullPhrasingSpans),
  JS.object("atBreak", true, "character", "`"),
  JS.object("character", "`", "inConstruct", JS.array("codeFencedLangGraveAccent", "codeFencedMetaGraveAccent")),
  JS.object("character", "`", "inConstruct", "phrasing", "notInConstruct", fullPhrasingSpans),
  JS.object("atBreak", true, "character", "~")
);
