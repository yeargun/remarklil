import { jsString, mathMax, mathMin, objectAssign, regexTest, undef } from "../../parse/micromark/host.lil";
import { encodeCharacterReference } from "../util/encode-character-reference.lil";
import { formatHeadingAsSetext } from "../util/format-heading-as-setext.lil";

Regex leadingWs = new Regex("^[\\t ]", "");

JsValue headingHandle(JsValue _self, JsValue args) {
  JsValue node = args[0];
  JsValue state = args[2];
  JsValue info = args[3];
  float depth = 1.0;
  JsValue depthV = node["depth"];
  if (depthV.truthy()) {
    depth = JS.number(depthV);
  }
  int rank = mathMax(mathMin(6.0, depth), 1.0).toInt();
  JsValue tracker = JS.invoke(state, "createTracker", info);
  if (formatHeadingAsSetext(node, state)) {
    JsValue exit = JS.invoke(state, "enter", "headingSetext");
    JsValue subexit = JS.invoke(state, "enter", "phrasing");
    JsValue setextInfo = objectAssign(JS.object(), JS.invoke(tracker, "current"));
    setextInfo["before"] = "\n";
    setextInfo["after"] = "\n";
    string value = jsString(JS.invoke(state, "containerPhrasing", node, setextInfo));
    JS.call(subexit, undef());
    JS.call(exit, undef());
    string bar = "-";
    if (rank == 1) {
      bar = "=";
    }
    int lastCr = value.lastIndexOf("\r");
    int lastLf = value.lastIndexOf("\n");
    int afterEol = mathMax(lastCr * 1.0, lastLf * 1.0).toInt() + 1;
    return value + "\n" + bar.repeat(value.length - afterEol);
  }
  string sequence = "#".repeat(rank);
  JsValue exit = JS.invoke(state, "enter", "headingAtx");
  JsValue subexit = JS.invoke(state, "enter", "phrasing");
  JS.invoke(tracker, "move", sequence + " ");
  JsValue atxInfo = objectAssign(JS.object(), JS.invoke(tracker, "current"));
  atxInfo["before"] = "# ";
  atxInfo["after"] = "\n";
  string value = jsString(JS.invoke(state, "containerPhrasing", node, atxInfo));
  if (regexTest(leadingWs, value)) {
    value = encodeCharacterReference(value.charCodeAt(0)) + value.slice(1);
  }
  if (value.length > 0) {
    value = sequence + " " + value;
  } else {
    value = sequence;
  }
  if ((state["options"])["closeAtx"].truthy()) {
    value = value + " " + sequence;
  }
  JS.call(subexit, undef());
  JS.call(exit, undef());
  return value;
}

export JsValue heading = JS.methodRest(headingHandle);
