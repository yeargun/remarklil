  JsValue tracker = JS.invoke(state, "createTracker", info);
  string value = jsString(JS.invoke(tracker, "move", "["));
  JsValue textInfo = objectAssign(JS.object(), JS.invoke(tracker, "current"));
  textInfo["before"] = value;
  textInfo["after"] = "]";
