import { jsString, undef } from "../../parse/micromark/host.lil";

JsValue mapBlockquote(JsValue _self, JsValue line, JsValue _index, JsValue blank) {
  if (blank.truthy()) {
    return ">" + jsString(line);
  }
  return "> " + jsString(line);
}

JsValue blockquoteHandle(JsValue _self, JsValue args) {
  JsValue node = args[0];
  JsValue state = args[2];
  JsValue info = args[3];
  JsValue exit = JS.invoke(state, "enter", "blockquote");
  JsValue tracker = JS.invoke(state, "createTracker", info);
  JS.invoke(tracker, "move", "> ");
  JS.invoke(tracker, "shift", 2);
  string value = jsString(
    JS.invoke(state, "indentLines", JS.invoke(state, "containerFlow", node, JS.invoke(tracker, "current")), JS.method3(mapBlockquote))
  );
  JS.call(exit, undef());
  return value;
}

export JsValue blockquote = JS.methodRest(blockquoteHandle);
