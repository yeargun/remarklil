import { jsString, undef } from "../../parse/micromark/host.lil";

JsValue mapBlockquote(JsValue _self, JsValue line, JsValue _index, JsValue blank) {
  if (blank.truthy()) {
    return ">" + jsString(line);
  }
  return "> " + jsString(line);
}

JsValue blockquoteHandle(JsValue _self, JsValue args) {
  JsValue node = args[0];
  JsValue state = args[2];
  JsValue info = args[3];
  JsValue exit = JS.call(JS.get(state, "enter"), state, "blockquote");
  JsValue tracker = JS.call(JS.get(state, "createTracker"), state, info);
  JS.call(JS.get(tracker, "move"), tracker, "> ");
  JS.call(JS.get(tracker, "shift"), tracker, 2);
  string value = jsString(
    JS.call(
      JS.get(state, "indentLines"),
      state,
      JS.call(JS.get(state, "containerFlow"), state, node, JS.call(JS.get(tracker, "current"), tracker)),
      JS.method3(mapBlockquote)
    )
  );
  JS.call(exit, undef());
  return value;
}

export JsValue blockquote = JS.methodRest(blockquoteHandle);
