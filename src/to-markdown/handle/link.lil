import { jsString, objectAssign, regexTest, undef } from "../../parse/micromark/host.lil";
import { checkQuote } from "../util/check-quote.lil";
import { formatLinkAsAutolink } from "../util/format-link-as-autolink.lil";

Regex controlOrWs = new Regex("[\\x00- \\x7F]", "");

JsValue linkPeek(JsValue _self, JsValue node, JsValue _parent, JsValue state) {
  if (formatLinkAsAutolink(node, state)) {
    return "<";
  }
  return "[";
}

JsValue linkHandle(JsValue _self, JsValue args) {
  JsValue node = args[0];
  JsValue state = args[2];
  JsValue info = args[3];
  string quote = checkQuote(state);
  string suffix = "Apostrophe";
  if (quote == "\"") {
    suffix = "Quote";
  }
  JsValue tracker = JS.invoke(state, "createTracker", info);
  JsValue exit = JS.undefined();
  JsValue subexit = JS.undefined();
  if (formatLinkAsAutolink(node, state)) {
    JsValue stack = state["stack"];
    state["stack"] = JS.array();
    exit = JS.invoke(state, "enter", "autolink");
    string value = jsString(JS.invoke(tracker, "move", "<"));
    JsValue autoInfo = objectAssign(JS.object(), JS.invoke(tracker, "current"));
    autoInfo["before"] = value;
    autoInfo["after"] = ">";
    value = value + jsString(JS.invoke(tracker, "move", JS.invoke(state, "containerPhrasing", node, autoInfo)));
    value = value + jsString(JS.invoke(tracker, "move", ">"));
    JS.call(exit, undef());
    state["stack"] = stack;
    return value;
  }
  exit = JS.invoke(state, "enter", "link");
  subexit = JS.invoke(state, "enter", "label");
  string value = jsString(JS.invoke(tracker, "move", "["));
  JsValue labelInfo = objectAssign(JS.object(), JS.invoke(tracker, "current"));
  labelInfo["before"] = value;
  labelInfo["after"] = "](";
  value = value + jsString(JS.invoke(tracker, "move", JS.invoke(state, "containerPhrasing", node, labelInfo)));
  value = value + jsString(JS.invoke(tracker, "move", "]("));
  JS.call(subexit, undef());
  JsValue url = node["url"];
  bool literal = !url.truthy() && node["title"].truthy();
  if (!literal && url is string && regexTest(controlOrWs, url)) {
    literal = true;
  }
  if (literal) {
    subexit = JS.invoke(state, "enter", "destinationLiteral");
    value = value + jsString(JS.invoke(tracker, "move", "<"));
    JsValue destInfo = objectAssign(JS.object(), JS.invoke(tracker, "current"));
    destInfo["before"] = value;
    destInfo["after"] = ">";
    value = value + jsString(JS.invoke(tracker, "move", JS.invoke(state, "safe", url, destInfo)));
    value = value + jsString(JS.invoke(tracker, "move", ">"));
  } else {
    subexit = JS.invoke(state, "enter", "destinationRaw");
    JsValue destInfo = objectAssign(JS.object(), JS.invoke(tracker, "current"));
    destInfo["before"] = value;
    if (node["title"].truthy()) {
      destInfo["after"] = " ";
    } else {
      destInfo["after"] = ")";
    }
    value = value + jsString(JS.invoke(tracker, "move", JS.invoke(state, "safe", url, destInfo)));
  }
  JS.call(subexit, undef());
  if (node["title"].truthy()) {
    subexit = JS.invoke(state, "enter", "title" + suffix);
    value = value + jsString(JS.invoke(tracker, "move", " " + quote));
    JsValue titleInfo = objectAssign(JS.object(), JS.invoke(tracker, "current"));
    titleInfo["before"] = value;
    titleInfo["after"] = quote;
    value = value + jsString(JS.invoke(tracker, "move", JS.invoke(state, "safe", node["title"], titleInfo)));
    value = value + jsString(JS.invoke(tracker, "move", quote));
    JS.call(subexit, undef());
  }
  value = value + jsString(JS.invoke(tracker, "move", ")"));
  JS.call(exit, undef());
  return value;
}

export JsValue link = JS.methodRest(linkHandle);
link["peek"] = JS.method3(linkPeek);
