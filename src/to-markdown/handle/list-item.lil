import { jsString, mathCeil, undef } from "../../parse/micromark/host.lil";
import { checkBullet } from "../util/check-bullet.lil";
import { checkListItemIndent } from "../util/check-list-item-indent.lil";

JsValue listItemHandle(JsValue _self, JsValue args) {
  JsValue node = args[0];
  JsValue parent = args[1];
  JsValue state = args[2];
  JsValue info = args[3];
  string listItemIndent = checkListItemIndent(state);
  string bullet = checkBullet(state);
  JsValue bulletV = state["bulletCurrent"];
  if (bulletV.truthy()) {
    bullet = jsString(bulletV);
  }
  if (parent.truthy() && jsString(parent["type"]) == "list" && parent["ordered"].truthy()) {
    int start = 1;
    JsValue startV = parent["start"];
    if (JS.typeOf(startV) == "number" && JS.number(startV) > -1.0) {
      start = JS.number(startV).toInt();
    }
    int offset = 0;
    if (!JS.strictEqual((state["options"])["incrementListMarker"], false)) {
      offset = JS.number(JS.invoke(parent["children"], "indexOf", node)).toInt();
    }
    bullet = (start + offset).toString() + bullet;
  }
  int size = bullet.length + 1;
  bool wide = listItemIndent == "tab";
  if (!wide && listItemIndent == "mixed") {
    bool parentSpread = parent.truthy() && jsString(parent["type"]) == "list" && parent["spread"].truthy();
    if (parentSpread || node["spread"].truthy()) {
      wide = true;
    }
  }
  if (wide) {
    size = mathCeil(size * 1.0 / 4.0).toInt() * 4;
  }
  JsValue tracker = JS.invoke(state, "createTracker", info);
  JS.invoke(tracker, "move", bullet + " ".repeat(size - bullet.length));
  JS.invoke(tracker, "shift", size);
  JsValue exit = JS.invoke(state, "enter", "listItem");
  JsValue mapper = JS.method3((JsValue _s, JsValue line, JsValue index, JsValue blank) => {
    string text = jsString(line);
    if (JS.number(index) != 0.0) {
      if (blank.truthy()) {
        return text;
      }
      return " ".repeat(size) + text;
    }
    if (blank.truthy()) {
      return bullet + text;
    }
    return bullet + " ".repeat(size - bullet.length) + text;
  });
  string value = jsString(
    JS.invoke(state, "indentLines", JS.invoke(state, "containerFlow", node, JS.invoke(tracker, "current")), mapper)
  );
  JS.call(exit, undef());
  return value;
}

export JsValue listItem = JS.methodRest(listItemHandle);
