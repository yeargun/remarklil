import { jsString, mathMax, objectAssign, undef } from "../../parse/micromark/host.lil";
import { longestStreak } from "../../deps/longest-streak.lil";
import { formatCodeAsIndented } from "../util/format-code-as-indented.lil";
import { checkFence } from "../util/check-fence.lil";

JsValue mapIndented(JsValue _self, JsValue line, JsValue _index, JsValue blank) {
  if (blank.truthy()) {
    return jsString(line);
  }
  return "    " + jsString(line);
}

JsValue codeHandle(JsValue _self, JsValue args) {
  JsValue node = args[0];
  JsValue state = args[2];
  JsValue info = args[3];
  string marker = checkFence(state);
  string raw = "";
  if (node["value"].truthy()) {
    raw = jsString(node["value"]);
  }
  string suffix = "Tilde";
  if (marker == "`") {
    suffix = "GraveAccent";
  }
  if (formatCodeAsIndented(node, state)) {
    JsValue exit = JS.invoke(state, "enter", "codeIndented");
    string indented = jsString(JS.invoke(state, "indentLines", raw, JS.method3(mapIndented)));
    JS.call(exit, undef());
    return indented;
  }
  JsValue tracker = JS.invoke(state, "createTracker", info);
  int streak = longestStreak(raw, marker);
  float seqLen = mathMax((streak + 1) * 1.0, 3.0);
  string sequence = marker.repeat(seqLen.toInt());
  JsValue exit = JS.invoke(state, "enter", "codeFenced");
  string value = jsString(JS.invoke(tracker, "move", sequence));
  if (node["lang"].truthy()) {
    JsValue subexit = JS.invoke(state, "enter", "codeFencedLang" + suffix);
    JsValue langInfo = objectAssign(JS.object(), JS.invoke(tracker, "current"));
    langInfo["before"] = value;
    langInfo["after"] = " ";
    JsValue encode = JS.array();
    JS.push(encode, "`");
    langInfo["encode"] = encode;
    value = value + jsString(JS.invoke(tracker, "move", JS.invoke(state, "safe", node["lang"], langInfo)));
    JS.call(subexit, undef());
  }
  if (node["lang"].truthy() && node["meta"].truthy()) {
    JsValue subexit = JS.invoke(state, "enter", "codeFencedMeta" + suffix);
    value = value + jsString(JS.invoke(tracker, "move", " "));
    JsValue metaInfo = objectAssign(JS.object(), JS.invoke(tracker, "current"));
    metaInfo["before"] = value;
    metaInfo["after"] = "\n";
    JsValue encode = JS.array();
    JS.push(encode, "`");
    metaInfo["encode"] = encode;
    value = value + jsString(JS.invoke(tracker, "move", JS.invoke(state, "safe", node["meta"], metaInfo)));
    JS.call(subexit, undef());
  }
  value = value + jsString(JS.invoke(tracker, "move", "\n"));
  if (raw.length > 0) {
    value = value + jsString(JS.invoke(tracker, "move", raw + "\n"));
  }
  value = value + jsString(JS.invoke(tracker, "move", sequence));
  JS.call(exit, undef());
  return value;
}

export JsValue code = JS.methodRest(codeHandle);
