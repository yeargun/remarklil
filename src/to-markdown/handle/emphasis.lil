import { jsString, objectAssign, undef } from "../../parse/micromark/host.lil";
import { checkEmphasis } from "../util/check-emphasis.lil";
import { encodeCharacterReference } from "../util/encode-character-reference.lil";
import { encodeInfo } from "../util/encode-info.lil";
import { jsCharCodeAt } from "../js.lil";

JsValue emphasisPeek(JsValue _self, JsValue _node, JsValue _parent, JsValue state) {
  JsValue marker = (state["options"])["emphasis"];
  if (marker.truthy()) {
    return marker;
  }
  return "*";
}

JsValue emphasisHandle(JsValue _self, JsValue args) {
  JsValue node = args[0];
  JsValue state = args[2];
  JsValue info = args[3];
  string marker = checkEmphasis(state);
  JsValue exit = JS.invoke(state, "enter", "emphasis");
  JsValue tracker = JS.invoke(state, "createTracker", info);
  string before = jsString(JS.invoke(tracker, "move", marker));
  JsValue phrasingInfo = objectAssign(JS.object(), JS.invoke(tracker, "current"));
  phrasingInfo["after"] = marker;
  phrasingInfo["before"] = before;
  string between = jsString(JS.invoke(tracker, "move", JS.invoke(state, "containerPhrasing", node, phrasingInfo)));
  JsValue betweenHead = jsCharCodeAt(between, 0);
  string beforeStr = jsString(info["before"]);
  JsValue open = encodeInfo(jsCharCodeAt(beforeStr, beforeStr.length - 1), betweenHead, marker);
  if (open["inside"].truthy()) {
    between = encodeCharacterReference(betweenHead) + between.slice(1);
  }
  JsValue betweenTail = jsCharCodeAt(between, between.length - 1);
  string afterStr = jsString(info["after"]);
  JsValue close = encodeInfo(jsCharCodeAt(afterStr, 0), betweenTail, marker);
  if (close["inside"].truthy()) {
    between = between.slice(0, between.length - 1) + encodeCharacterReference(betweenTail);
  }
  string after = jsString(JS.invoke(tracker, "move", marker));
  JS.call(exit, undef());
  state["attentionEncodeSurroundingInfo"] = JS.object("after", close["outside"], "before", open["outside"]);
  return before + between + after;
}

export JsValue emphasis = JS.methodRest(emphasisHandle);
emphasis["peek"] = JS.method3(emphasisPeek);
