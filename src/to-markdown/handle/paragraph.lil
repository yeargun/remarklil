import { jsString, undef } from "../../parse/micromark/host.lil";

JsValue paragraphHandle(JsValue _self, JsValue args) {
  JsValue node = args[0];
  JsValue state = args[2];
  JsValue info = args[3];
  JsValue exit = JS.invoke(state, "enter", "paragraph");
  JsValue subexit = JS.invoke(state, "enter", "phrasing");
  string value = jsString(JS.invoke(state, "containerPhrasing", node, info));
  JS.call(subexit, undef());
  JS.call(exit, undef());
  return value;
}

export JsValue paragraph = JS.methodRest(paragraphHandle);
