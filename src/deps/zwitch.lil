import { apply, hasOwn, isNullish, jsString, undef } from "../parse/micromark/host.lil";

export JsValue zwitch(string key, JsValue options) {
  JsValue settings = options;
  if (isNullish(settings)) {
    settings = JS.object();
  }
  JsValue one = JS.undefined();
  one = JS.methodRest((JsValue self, JsValue args) => {
    JsValue value = undef();
    if (args.length.toInt() > 0) {
      value = args[0];
    }
    JsValue fn = one["invalid"];
    JsValue handlers = one["handlers"];
    if (value.truthy() && hasOwn(value, key)) {
      string id = jsString(JS.get(value, key));
      if (hasOwn(handlers, id)) {
        fn = JS.get(handlers, id);
      } else {
        fn = one["unknown"];
      }
    }
    if (fn.truthy()) {
      return apply(fn, self, args);
    }
    return undef();
  });
  JsValue handlers = settings["handlers"];
  if (isNullish(handlers)) {
    handlers = JS.object();
  }
  one["handlers"] = handlers;
  one["invalid"] = settings["invalid"];
  one["unknown"] = settings["unknown"];
  return one;
}
