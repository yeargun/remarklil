import { Flags, ParseHost, docText, mergeFlags, readSettings } from "./host.lil";
import { fromMarkdown } from "./parse.lil";
import { toMarkdown } from "./stringify.lil";
import { Processor, createProcessor } from "./unified.lil";

JsValue installParse(JsValue self, JsValue options) {
  ParseHost host = JS.assume(self);
  JsValue parser = JS.method2((JsValue _s, JsValue doc, JsValue file) => {
    Flags flags = mergeFlags(options, readSettings(self));
    return fromMarkdown(docText(doc, file), flags);
  });
  host.parser = parser;
  return JS.undefined();
}

JsValue installStringify(JsValue self, JsValue _options) {
  Processor proc = JS.assume(self);
  proc.compiler = JS.method2((JsValue _s, JsValue tree, JsValue _file) => {
    return toMarkdown(tree);
  });
  return JS.undefined();
}

JsValue remarkImpl() {
  JsValue proc = createProcessor();
  JS.call(JS.method1(installParse), proc, JS.undefined());
  JS.call(JS.method1(installStringify), proc, JS.undefined());
  return proc;
}

export JsValue remark = remarkImpl;
export JsValue default = remarkImpl;
