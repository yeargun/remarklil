import { unified } from "./unified/entry.lil";
import { remarkParse } from "./parse/remark-parse.lil";
import { remarkStringify as remarkStringifyPlugin } from "./stringify.lil";
import { defaultHandlersExport, toMarkdown as toMarkdownFn } from "./to-markdown/index.lil";

JsValue remarkValue = JS.call(unified, JS.undefined());
remarkValue = JS.call(JS.get(remarkValue, "use"), remarkValue, remarkParse);
remarkValue = JS.call(JS.get(remarkValue, "use"), remarkValue, remarkStringifyPlugin);
remarkValue = JS.call(JS.get(remarkValue, "freeze"), remarkValue);

export JsValue default = remarkValue;
export JsValue defaultHandlers = defaultHandlersExport;
export JsValue remark = remarkValue;
export JsValue remarkStringify = remarkStringifyPlugin;
export JsValue toMarkdown = toMarkdownFn;
